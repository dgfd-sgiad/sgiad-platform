# SGIAD - Variables d'environnement
# ===================================
# Copiez ce fichier en .env et remplissez les valeurs.
#
# 1. Creer un compte sur https://supabase.com
# 2. Creer un nouveau projet
# 3. Aller dans Settings > API
# 4. Copier l'URL et la cle service_role (serveur Flask uniquement, ne jamais exposer au client)
# 5. Executer schema.sql puis schema_rls.sql dans le SQL Editor de Supabase
# 6. Lancer: python scripts/migrate_to_supabase.py

# ── Supabase (obligatoire) ──
SUPABASE_URL=https://VOTRE-PROJET.supabase.co
# Cle service_role recommandee pour le backend Flask (contourne RLS cote serveur)
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Mot de passe PostgreSQL (optionnel, pour /api/setup/create-tables uniquement)
# SUPABASE_DB_PASSWORD=

# ── Flask (optionnel) ──
FLASK_ENV=development
FLASK_DEBUG=1

# ── Auth / securite ──
# false = inscriptions fermees (recommande en production)
SIGNUP_ENABLED=false
# Domaines autorises pour l'inscription (ex: finances.bj,gouv.bj). Vide = tous si SIGNUP_ENABLED=true
ALLOWED_EMAIL_DOMAINS=

# ── Veille (optionnel) ──
# GEMINI_API_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── CORS (optionnel, virgules) ──
# CORS_ORIGINS=https://sgiad-platform.onrender.com
